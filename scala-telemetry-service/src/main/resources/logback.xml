<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Suppress verbose Pekko / HTTP debug chatter so only WARN/ERROR or custom logs show -->
    <logger name="org.apache.pekko" level="WARN" />
    <logger name="org.apache.pekko.http" level="WARN" />
    <logger name="agile.rover" level="INFO" />

    <root level="WARN">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>

